# ==========================================
# 1. SSH / Security Keys & Certificates
# ==========================================
id_*
*_ed25519
*.pem
*.pub
*.key
*.pfx
*.p12
vps-key

# ==========================================
# 2. Environment variables & Secrets
# ==========================================
.env
.env.*
!.env.example

# ==========================================
# 3. Application configurations with secrets
# ==========================================
app.ini
config.ini
secrets.yml
!configs/gitea/app.ini.example

# Ignore pre-render cloud-init configuration (to prevent secret leaks)
configs/cloud-init/user-data
*.rendered

# ==========================================
# 4. Database dumps, Backups & Logs
# ==========================================
*.sql
*.dump
*.sqlite3
*.log
*.tar.gz
*.zip

# ==========================================
# 5. Images
# ==========================================
*.iso
*.img
*.qcow2

# ==========================================
# 6. OS & Editor System Artifacts
# ==========================================
.DS_Store
.vscode/
.idea/
