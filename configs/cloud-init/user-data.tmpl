#cloud-config

# The template is rendered using envsubst.
# meta-data is generated by a script for each node created.

# 1. Disabling password-based SSH login.
ssh_pwauth: false
disable_root: true

# 2. User settings.
users:
  - name: devops
    gecos: DevOps Archi
    groups: [sudo]
    shell: /bin/bash
    lock_passwd: true
    sudo: ['ALL=(ALL) NOPASSWD:ALL']
    ssh_authorized_keys:
      - ${SSH_PUBKEY}
    
# 3. Update the package list and install qemu-guest-agent.
package_update: true
package_upgrade: false
packages:
  - qemu-guest-agent
